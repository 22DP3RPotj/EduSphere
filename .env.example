# Environment
DJANGO_ENV='development' # (development|staging|production|testing)

# Secret key
SECRET_KEY=example_secret_key

# Frontend
FRONTEND_URL=http://localhost

# Domain used by nginx server_name, grafana, and django ALLOWED_HOSTS
NGINX_HOST=localhost

# Server
ALLOWED_HOSTS=localhost,127.0.0.1,backend

CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database
POSTGRES_DB=example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://example_user:example_pass@postgres:5432/example_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Grafana
GF_SECURITY_ADMIN_USER=gf_user
GF_SECURITY_ADMIN_PASSWORD=gf_pass

# TLS / Let's Encrypt (production only)
# Email used by certbot for certificate expiry notices
CERTBOT_EMAIL=you@example.com

# SendGrid (optional — console email backend used if absent)
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@yourdomain.com
